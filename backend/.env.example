# PostgreSQL-Datenbank für Docker Compose
DB_HOST=db             # WICHTIG: 'db' ist der Servicename im docker-compose.yml!
DB_PORT=5432
DB_USERNAME=dhcpuser   # Muss mit POSTGRES_USER in docker-compose.yml übereinstimmen!
DB_PASSWORD=dhcppass   # Muss mit POSTGRES_PASSWORD übereinstimmen!
DB_NAME=dhcpdb         # Muss mit POSTGRES_DB übereinstimmen!

# Anwendungsspezifische Secrets (nur Beispiele, können von jedem Kollegen ersetzt werden)
CREDENTIAL_SECRET=demo_credential_secret
JWT_SECRET=demo_jwt_secret
PORT=3001

# CSP API (nur Demo/Entwicklung, bei Bedarf ersetzen)
CSP_API_KEY=demo_csp_api_key
CSP_BASE_URL=https://csp.infoblox.com/api/ddi/v1
